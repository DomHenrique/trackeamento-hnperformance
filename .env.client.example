# ==============================================================================
# Configuração de Ambiente para Novo Cliente (Docker Hub & Instância Isolada)
# ==============================================================================
# Copie este arquivo para .env.<cliente> (ex: .env.meucliente)
# e personalize os valores abaixo antes de subir a stack.
# ==============================================================================

# Identificador exclusivo do cliente (sem espaços ou caracteres especiais)
# Usado para nomear containers, pastas de dados e regras de roteamento
CLIENT_SLUG=novo_cliente
TAG=latest

# Ambiente e Subdomínio First-Party do Cliente
ENV=production
# Subdomínio CNAME apontado para a VPS (ex: dados.sitecliente.com.br ou track.sitecliente.com.br)
TRACKING_DOMAIN=track.sitecliente.com.br
ACME_EMAIL=admin@hnperformancedigital.com.br
HTTP_PORT=8080

# Portas no Host para evitar conflito com a SPS Power
# (SPS Power usa 5432, 6379, 8123, 9000)
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
CLICKHOUSE_HTTP_HOST_PORT=18123
CLICKHOUSE_NATIVE_HOST_PORT=19000

# Rede do Traefik existente na VPS (ex: tracking-net ou rede_gridd)
TRAEFIK_NETWORK=tracking-net

# Credenciais do Administrador Mestre deste Cliente (mín. 12 caracteres)
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_admin_password_min_16_chars

# Chaves de Criptografia Interna (mín. 16 caracteres)
SERVER_API_KEY=generate_random_secret_server_key_32_chars
HMAC_PEPPER=generate_random_hmac_pepper_secret_salt_32_chars

# Redis Interno do Cliente
REDIS_ADDR=novo_cliente-redis:6379
REDIS_PASSWORD=generate_strong_redis_password_min_16_chars
REDIS_STREAM_RAW=stream:events:raw
REDIS_STREAM_DISPATCH=stream:events:dispatch
REDIS_CONSUMER_GROUP=tracking_workers

# PostgreSQL Interno do Cliente
POSTGRES_HOST=novo_cliente-postgres
POSTGRES_PORT=5432
POSTGRES_DB=tracking_db
POSTGRES_USER=tracking_user
POSTGRES_PASSWORD=generate_strong_postgres_password_min_16_chars
POSTGRES_SSLMODE=disable

# ClickHouse Interno do Cliente
CLICKHOUSE_ADDR=novo_cliente-clickhouse:9000
CLICKHOUSE_DB=tracking_events
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=generate_strong_clickhouse_password_min_16_chars

# Ingester Batching Settings
INGESTER_BATCH_SIZE=2000
INGESTER_FLUSH_INTERVAL_SEC=2

# Dispatcher Worker Settings
DISPATCHER_WORKERS=8
DISPATCHER_MAX_RETRIES=5
DISPATCHER_TIMEOUT_SEC=10

# Bootstrap Declarativo Opcional
SEED_DEFAULT_SITE=false
DEFAULT_CLIENT_NAME=Novo Cliente
DEFAULT_SITE_NAME=Site Principal
DEFAULT_SITE_DOMAIN=sitecliente.com.br

# Proxies Confiáveis (Prevenção contra IP Spoofing)
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8
