# Ambiente e Domínio
ENV=production
TRACKING_DOMAIN=trackeamento.hnperformancedigital.com.br
ACME_EMAIL=admin@hnperformancedigital.com.br
HTTP_PORT=8080

# Credenciais do Administrador Mestre da Aplicação (Obrigatório em produção - mín. 12 caracteres)
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_admin_password_min_16_chars

# Chaves de Criptografia Interna (Obrigatório em produção - mín. 16 caracteres)
SERVER_API_KEY=generate_random_secret_server_key_32_chars
HMAC_PEPPER=generate_random_hmac_pepper_secret_salt_32_chars

# Redis (Buffer e Filas de Streaming - Obrigatório em produção)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=generate_strong_redis_password_min_16_chars
REDIS_STREAM_RAW=stream:events:raw
REDIS_STREAM_DISPATCH=stream:events:dispatch
REDIS_CONSUMER_GROUP=tracking_workers

# PostgreSQL (Metadados e Identidade - Obrigatório em produção)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tracking_db
POSTGRES_USER=tracking_user
POSTGRES_PASSWORD=generate_strong_postgres_password_min_16_chars
POSTGRES_SSLMODE=disable

# ClickHouse (Série Temporal e Eventos Analíticos - Obrigatório em produção)
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DB=tracking_events
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=generate_strong_clickhouse_password_min_16_chars

# Ingester Batching Settings
INGESTER_BATCH_SIZE=2000
INGESTER_FLUSH_INTERVAL_SEC=2

# Dispatcher Worker Settings
DISPATCHER_WORKERS=8
DISPATCHER_MAX_RETRIES=5
DISPATCHER_TIMEOUT_SEC=10

# [OPCIONAL] Bootstrap Declarativo de Site Inicial no primeiro deploy
# SEED_DEFAULT_SITE=false (Padrão: a aplicação inicia limpa com 0 sites cadastrados)
# Se alterado para true em um banco vazio, provisiona automaticamente o primeiro site/organização:
SEED_DEFAULT_SITE=false
DEFAULT_CLIENT_NAME=Minha Organização
DEFAULT_SITE_NAME=Meu Site Principal
DEFAULT_SITE_DOMAIN=

